# Development settings for your agent: copy to .env (ignored by git and docker build).
# The image must not need this file: put the values it runs with in the Dockerfile as ENV, and
# hand over <team>.env at code freeze (README: Code-freeze handover). KEY=VALUE, no quotes.
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=Qwen/Qwen3.8-27B-FP8

# Optional agent tuning (19-min ceiling cleanly under 20-min competition cap)
CAD_MAX_WORKERS=3
CAD_GLOBAL_TIMEOUT_S=1140
CAD_LLM_TIMEOUT_S=180
CAD_TOOLS=1
CAD_MAX_TOOL_STEPS=3
CAD_BEST_OF_K=2
CAD_IOU_EARLY_EXIT=0.95
CAD_TEMPERATURE=0.8
CAD_THINKING=auto
CAD_REASONING_EFFORT=auto
